# Set in Supabase Edge Function Secrets, NOT in GitHub or src/config.json.
# Use at least 24 random characters, not an account password.
# Optional when the invitation is stored in Supabase Vault by the deployment
# procedure. If set, this Edge Function secret takes precedence over Vault.
DIARY_INVITE_CODE=REPLACE_WITH_NEW_RANDOM_INVITATION
ALLOWED_ORIGIN=https://YOUR_USERNAME.github.io
AUTH_DOMAIN=users.neo-fit.invalid
# SUPABASE_URL and SUPABASE_SECRET_KEYS are supplied by Supabase runtime.
# SUPABASE_SERVICE_ROLE_KEY remains a temporary legacy fallback.
